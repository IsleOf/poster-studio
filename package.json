{
  "name": "poster-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.js",
    "start": "node server/index.js & vite",
    "server": "node server/save-server.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "listings:sync": "node scripts/sync-listing-state.cjs",
    "listings:audit": "node scripts/audit-listing-parity.cjs",
    "listings:verify": "node scripts/verify-listing.cjs",
    "mockups:compose": "python3 scripts/composite-mockups.py",
    "stress:render": "node scripts/stress-render.cjs",
    "prod:pull-state": "bash scripts/pull-production-state.sh",
    "prod:health": "bash scripts/check-production-health.sh",
    "prod:apply-hardening": "bash scripts/apply-production-hardening.sh",
    "prod:integrity": "bash scripts/check-production-integrity.sh",
    "test": "npx playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:update": "npx playwright test --update-snapshots",
    "test:continue": "npx playwright test -c playwright.continuation.config.ts",
    "test:continue:update": "npx playwright test -c playwright.continuation.config.ts --update-snapshots",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report tests/report"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@mapbox/vector-tile": "^2.0.4",
    "@types/d3": "^7.4.3",
    "@types/d3-drag": "^3.0.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "d3-drag": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "framer-motion": "^12.23.24",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.554.0",
    "maplibre-gl": "^5.6.1",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.3",
    "pbf": "^4.0.1",
    "puppeteer": "^24.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.4"
  }
}
